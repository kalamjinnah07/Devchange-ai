# Environment Variables — DevChange AI
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# For local development: postgresql://user:password@localhost:5432/devchange
# For Neon.tech (recommended): copy the connection string from your Neon dashboard.
DATABASE_URL="postgresql://user:password@localhost:5432/devchange"

# ─── IBM watsonx.ai ──────────────────────────────────────────────────────────
# IBM Cloud API key — create one at:
# https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=""

# watsonx.ai project ID — find this in your watsonx.ai project settings.
WATSONX_PROJECT_ID=""

# watsonx.ai base URL including region.
# Format: https://{region}.ml.cloud.ibm.com
# Common regions: us-south, eu-de, jp-tok, au-syd
WATSONX_URL="https://us-south.ml.cloud.ibm.com"

# Foundation model ID to use for inference.
# Default: ibm/granite-3-3-8b-instruct
#   - Multitenant (no deployment required)
#   - Instruction-following, 131,072-token context window
#   - IBM-provided, not deprecated as of May 2025
# Override this env var to switch models without code changes.
WATSONX_MODEL_ID="ibm/granite-3-3-8b-instruct"
